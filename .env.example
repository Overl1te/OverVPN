# Copy this file to .env and replace every REPLACE_* value before startup.
# Generate URL-safe secrets with: openssl rand -hex 32
# Generate the bootstrap password with: openssl rand -base64 36
# Never commit .env. If non-URL-safe passwords are used, URL-encode them in *_URL values.
# Panel UI defaults to Russian (EN available in the header language switcher).

NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=true
SWAGGER_ENABLED=false

POSTGRES_DB=overvpn
POSTGRES_USER=overvpn
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_HEX_SECRET
DATABASE_URL=postgresql://overvpn:REPLACE_WITH_POSTGRES_HEX_SECRET@postgres:5432/overvpn?schema=public
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

REDIS_PASSWORD=REPLACE_WITH_REDIS_HEX_SECRET
REDIS_URL=redis://:REPLACE_WITH_REDIS_HEX_SECRET@redis:6379/0
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

BOOTSTRAP_ADMIN_USER=owner
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_BOOTSTRAP_PASSWORD_MIN_16_CHARS

# Independent secrets; never reuse the database or Redis password.
JWT_ACCESS_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS_FOR_JWT_SIGNING
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=overvpn
JWT_AUDIENCE=overvpn-admin
REFRESH_TOKEN_TTL_SECONDS=2592000
SECRETS_MASTER_KEY=REPLACE_WITH_EXACTLY_64_HEX_CHARACTERS
SING_BOX_CLASH_API_SECRET=REPLACE_WITH_INDEPENDENT_64_HEX_CHARACTERS
TOTP_ISSUER=OverVPN

# Secure browser refresh-token cookie. Set a domain only when required.
AUTH_COOKIE_NAME=overvpn_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=strict
# AUTH_COOKIE_DOMAIN=vpn.example.com
AUTH_COOKIE_PATH=/api/admin/auth

# Login attempts per window, per client IP.
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL_MS=60000

# Public subscription base URL:
# - https://sub.example.com        → links like /api/sub/{TOKEN}
# - https://example.com/sub        → links like /sub/{TOKEN} (nginx rewrites to /api/sub)
SUB_PUBLIC_BASE_URL=https://sub.example.com
# Default public host for new inbounds (VPN client endpoint hostname/IP).
VPN_PUBLIC_HOST=vpn.example.com
# Subscription refresh recommendation (hours) and distributed fixed-window
# limits. Both the source-IP and token-fingerprint limits must allow a request.
SUB_PROFILE_UPDATE_INTERVAL_HOURS=6
SUB_RATE_LIMIT_IP_LIMIT=60
SUB_RATE_LIMIT_TOKEN_LIMIT=120
SUB_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated exact origins. Wildcards are rejected.
CORS_ORIGINS=http://localhost:8080

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# The published UDP port must match the inbound listen port configured in the panel.
SING_BOX_BIND_ADDRESS=0.0.0.0
SING_BOX_UDP_PORT=443
# ACME HTTP-01/TLS-ALPN-01 listeners; set matching alternative ports in the inbound when changed.
# With Nginx in front, the installer remaps these to 8081/8443 and syncs LE certs for FILES TLS.
SING_BOX_ACME_BIND_ADDRESS=0.0.0.0
SING_BOX_ACME_HTTP_PORT=80
SING_BOX_ACME_TLS_PORT=443
# Optional default FILES TLS paths (container paths). Filled by install.sh after Certbot.
# VPN_TLS_CERTIFICATE_PATH=/var/lib/sing-box-certs/vpn-fullchain.pem
# VPN_TLS_KEY_PATH=/var/lib/sing-box-certs/vpn-privkey.pem
SING_BOX_PROCESS_TIMEOUT_MS=15000
SING_BOX_RELOAD_TIMEOUT_MS=20000
SING_BOX_HEALTH_TIMEOUT_MS=5000

# Second data plane (Xray). Default TCP publish avoids colliding with sing-box VPN/ACME.
# With Nginx (ACME remapped to 8443), install.sh sets XRAY_LISTEN_PORT=9443.
XRAY_BIND_ADDRESS=0.0.0.0
XRAY_LISTEN_PORT=8443
XRAY_PROCESS_TIMEOUT_MS=15000
XRAY_RELOAD_TIMEOUT_MS=20000
XRAY_HEALTH_TIMEOUT_MS=5000
# XRAY_LOCATION_ASSET=/usr/local/share/xray

CORE_APPLY_LOCK_TTL_MS=60000

# Production API workers. Keep WORKERS_ENABLED=false in unit tests, one-off
# scripts, migration containers, and other tool processes.
WORKERS_ENABLED=true
WORKER_LOCK_TTL_MS=60000
TRAFFIC_COLLECTION_INTERVAL_MS=15000
TRAFFIC_AGGREGATION_INTERVAL_MS=60000
TRAFFIC_AGGREGATION_BATCH_SIZE=1000
TRAFFIC_LEDGER_RETENTION_DAYS=90
ONLINE_COLLECTION_INTERVAL_MS=15000
ONLINE_SWEEP_INTERVAL_MS=30000
ONLINE_SESSION_TIMEOUT_MS=90000
ONLINE_SESSION_RETENTION_DAYS=30
ENFORCEMENT_INTERVAL_MS=30000

# Optional bilingual (EN/RU) enforcement and core-apply failure notifications.
TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
# TELEGRAM_CHAT_ID=-1001234567890
TELEGRAM_TIMEOUT_MS=5000

# Backup artifacts (mounted at /var/lib/overvpn/backups in Compose).
BACKUP_DIR=/var/lib/overvpn/backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPT=true
BACKUP_PROCESS_TIMEOUT_MS=600000

# Native-development overrides (the Compose defaults are wired automatically).
# SING_BOX_BINARY_PATH=C:\path\to\sing-box.exe
# SING_BOX_CONFIG_PATH=C:\path\to\sing-box\config.json
# SING_BOX_LAST_KNOWN_GOOD_PATH=C:\path\to\sing-box\config.last-known-good.json
# SING_BOX_RELOAD_REQUEST_PATH=C:\path\to\reload\request
# SING_BOX_RELOAD_ACK_PATH=C:\path\to\reload\ack
# SING_BOX_CLASH_API_URL=http://127.0.0.1:9090
# SING_BOX_CLASH_API_LISTEN=127.0.0.1:9090
# SING_BOX_V2RAY_API_LISTEN=127.0.0.1:8080
# SING_BOX_V2RAY_API_ADDRESS=127.0.0.1:8080
# XRAY_BINARY_PATH=C:\path\to\xray.exe
# XRAY_CONFIG_PATH=C:\path\to\xray\config.json
# XRAY_LAST_KNOWN_GOOD_PATH=C:\path\to\xray\config.last-known-good.json
# XRAY_RELOAD_REQUEST_PATH=C:\path\to\xray-reload\request
# XRAY_RELOAD_ACK_PATH=C:\path\to\xray-reload\ack
# XRAY_API_LISTEN=127.0.0.1:10085
# XRAY_STATS_ADDRESS=127.0.0.1:10085

POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine

# Prebuilt images from GHCR (installer default). Use `overvpn install --build` or
# `docker compose ... up -d --build` to build locally instead of pulling.
API_IMAGE=ghcr.io/overl1te/overvpn-api:latest
WEB_IMAGE=ghcr.io/overl1te/overvpn-web:latest

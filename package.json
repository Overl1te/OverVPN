{
  "name": "overvpn",
  "version": "0.1.0",
  "private": true,
  "description": "VPN control plane (panel) + proxy-node agent",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @overvpn/api test:e2e",
    "prisma:generate": "pnpm --filter @overvpn/api prisma:generate",
    "prisma:validate": "pnpm --filter @overvpn/api prisma:validate",
    "migrate": "pnpm --filter @overvpn/api prisma:migrate:deploy",
    "migrate:dev": "pnpm --filter @overvpn/api prisma:migrate:dev",
    "bootstrap:admin": "pnpm --filter @overvpn/api admin:bootstrap",
    "compose-up": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.proxy.yml up -d",
    "compose-pull": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.proxy.yml pull",
    "compose-build": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.proxy.yml up -d --build",
    "compose-down": "docker compose --env-file .env -f deploy/docker-compose.yml -f deploy/docker-compose.proxy.yml down",
    "docs:build": "node scripts/build-docs.mjs && pagefind --site docs-dist --force-language ru",
    "docs:dev": "node scripts/build-docs.mjs --dev && pagefind --site docs-dist --force-language ru && npx --yes serve docs-dist -l 4173",
    "docs:preview": "pnpm docs:build && npx --yes serve docs-dist -l 4173"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3"
  }
}
